{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just --list*)",
      "Bash(just ci*)",
      "Bash(nix flake check*)",
      "Bash(nix eval*)",
      "Bash(nix build --dry-run*)",
      "Bash(nix search nixpkgs*)",
      "Bash(statix check*)",
      "Bash(deadnix*)",
      "Bash(editorconfig-checker*)",
      "Bash(typos*)",
      "Bash(lychee*)",
      "Bash(committed*)",
      "Bash(actionlint*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
